{
  "name": "warcraftlogs-mcp",
  "version": "0.2.1",
  "description": "A community MCP server for reliable, AI-friendly Warcraft Logs report analysis.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "warcraftlogs-mcp": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iRockyZhou/warcraftlogs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/iRockyZhou/warcraftlogs-mcp/issues"
  },
  "homepage": "https://github.com/iRockyZhou/warcraftlogs-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "warcraft",
    "warcraft-logs",
    "world-of-warcraft",
    "combat-logs"
  ],
  "author": "iRockyZhou",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:package": "publint && attw --pack .",
    "prepack": "pnpm build",
    "release": "pnpm build && changeset publish",
    "smoke": "pnpm build && node dist/cli.mjs doctor",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
