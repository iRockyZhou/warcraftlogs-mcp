WCL_CLIENT_ID=your_client_id
WCL_CLIENT_SECRET=your_client_secret
# Optional alternatives to `warcraftlogs-mcp auth login`; do not commit real tokens.
# WCL_USER_ACCESS_TOKEN=global_user_access_token
# WCL_CN_USER_ACCESS_TOKEN=cn_user_access_token
# Register this exact callback on your WCL API client before interactive login.
# WCL_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
# WCL_STATE_DIR=/absolute/path/to/private/state
# Optional reliability settings
# WCL_REQUEST_TIMEOUT_MS=15000
# WCL_MAX_RETRIES=2
# WCL_MAX_RETRY_AFTER_MS=2000
